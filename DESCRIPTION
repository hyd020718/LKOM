Package: LKOM
Type: Package
Title: Longitudinal Knockoffs with Masked Likelihood Ratios
Version: 0.1.0
Authors@R: c(
    person("Yundi", "Hu", role = c("aut", "cre"),
           email = "hyd020718@gmail.com"),
    person("He", "Xu", role = "aut"),
    person("Shiyang", "Ma", role = "aut"),
