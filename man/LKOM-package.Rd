\name{LKOM-package}
\alias{LKOM-package}
\alias{LKOM}
\title{Longitudinal Knockoffs with Masked Likelihood Ratios}
\description{
LKOM jointly analyzes trajectory-mean and within-subject variability channels
using paired model-X knockoffs, masked likelihood ratios, knockoff+ selection,
and post-selection association-state classification.
}
\details{
The reusable statistical method is included in the package. Cohort-specific
quality control, knockoff construction, and cluster submission scripts remain
separate reproducibility workflows.
}
\docType{package}

